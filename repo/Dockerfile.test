# syntax=docker/dockerfile:1
FROM node:20-alpine

# Install pnpm (pinned to match workspace)
RUN npm install -g pnpm@10

WORKDIR /app

# Copy .npmrc first so network retry/concurrency settings apply during install
COPY .npmrc pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY backend/package.json  ./backend/
COPY frontend/package.json ./frontend/
COPY shared/package.json   ./shared/

# Cache the pnpm content-addressable store across builds so packages are not
# re-downloaded when only source files change.  The mount is invisible to the
# final image layer (no size bloat).
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy full source (root tsconfig.json must be present — backend extends it)
COPY tsconfig.json       ./
COPY vitest.workspace.ts ./
COPY backend/  ./backend/
COPY frontend/ ./frontend/
COPY shared/   ./shared/

# Directory used by backend tests for image uploads
RUN mkdir -p /tmp/retail_hub_test_uploads

# Run backend (needs DB) then frontend (jsdom only) sequentially.
# Workspace mode runs both pools concurrently, which causes clearAllTables()
# in one backend test file's beforeEach to race against another file's seeds.
CMD ["sh", "-c", "pnpm --filter backend test:ci && pnpm --filter frontend test:ci"]
